{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "explanation": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Explanation",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "org_id": {
      "format": "uuid",
      "title": "Org Id",
      "type": "string"
    },
    "rule_version": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Rule Version",
      "type": "string"
    },
    "scenario_id": {
      "format": "uuid",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "source_finding_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Finding Ids",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "org_id",
    "scenario_id",
    "rule_version",
    "source_finding_ids",
    "evidence_ids",
    "explanation",
    "score",
    "limitations"
  ],
  "title": "RiskScenario",
  "type": "object"
}
