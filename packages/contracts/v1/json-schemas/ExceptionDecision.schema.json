{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "APPROVED",
        "REJECTED"
      ],
      "title": "Decision",
      "type": "string"
    },
    "reason": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "decision",
    "reason"
  ],
  "title": "ExceptionDecision",
  "type": "object"
}
