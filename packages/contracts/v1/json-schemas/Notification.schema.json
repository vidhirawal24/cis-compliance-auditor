{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_count": {
      "minimum": 0,
      "title": "Attempt Count",
      "type": "integer"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "notification_id": {
      "format": "uuid",
      "title": "Notification Id",
      "type": "string"
    },
    "org_id": {
      "format": "uuid",
      "title": "Org Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "PENDING",
        "DELIVERED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "org_id",
    "notification_id",
    "event_id",
    "status",
    "attempt_count"
  ],
  "title": "Notification",
  "type": "object"
}
