{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "MFA_REQUIRED",
        "NOT_FOUND",
        "VALIDATION_ERROR",
        "CONFLICT",
        "RATE_LIMITED",
        "UNSUPPORTED",
        "INSUFFICIENT_EVIDENCE",
        "APPROVAL_REQUIRED",
        "STALE_PLAN",
        "SAFETY_GATE_FAILED",
        "DEPENDENCY_UNAVAILABLE",
        "INTERNAL_ERROR"
      ],
      "title": "Code",
      "type": "string"
    },
    "details": {
      "anyOf": [
        {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Details"
    },
    "message": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    }
  },
  "required": [
    "code",
    "message",
    "request_id",
    "retryable"
  ],
  "title": "APIError",
  "type": "object"
}
