{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credential_reference_id": {
      "format": "uuid",
      "title": "Credential Reference Id",
      "type": "string"
    },
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "endpoint": {
      "pattern": "^https://",
      "title": "Endpoint",
      "type": "string"
    },
    "integration_id": {
      "format": "uuid",
      "title": "Integration Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "WEBHOOK",
        "TICKET"
      ],
      "title": "Kind",
      "type": "string"
    },
    "org_id": {
      "format": "uuid",
      "title": "Org Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "org_id",
    "kind",
    "endpoint",
    "credential_reference_id",
    "enabled",
    "integration_id"
  ],
  "title": "Integration",
  "type": "object"
}
