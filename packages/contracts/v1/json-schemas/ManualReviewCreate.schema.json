{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "finding_id": {
      "format": "uuid",
      "title": "Finding Id",
      "type": "string"
    },
    "rationale": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "VALIDATED",
        "REJECTED",
        "NEEDS_EVIDENCE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "finding_id",
    "verdict",
    "evidence_ids",
    "rationale"
  ],
  "title": "ManualReviewCreate",
  "type": "object"
}
