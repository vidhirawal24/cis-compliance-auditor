{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capability"
    },
    "code": {
      "enum": [
        "UNSUPPORTED",
        "AUTH_FAILED",
        "TIMEOUT",
        "PARSE_ERROR",
        "MISSING_EVIDENCE",
        "DEVICE_UNAVAILABLE"
      ],
      "title": "Code",
      "type": "string"
    },
    "message": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    }
  },
  "required": [
    "code",
    "message",
    "retryable"
  ],
  "title": "CollectorError",
  "type": "object"
}
