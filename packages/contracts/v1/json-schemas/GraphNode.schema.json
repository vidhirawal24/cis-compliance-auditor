{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "asset",
        "interface",
        "network",
        "route",
        "service",
        "policy",
        "control",
        "finding"
      ],
      "title": "Kind",
      "type": "string"
    },
    "label": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "node_id": {
      "format": "uuid",
      "title": "Node Id",
      "type": "string"
    }
  },
  "required": [
    "node_id",
    "kind",
    "label"
  ],
  "title": "GraphNode",
  "type": "object"
}
